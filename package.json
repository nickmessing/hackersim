{
  "name": "hackersim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "vue-tsc --build && eslint . && vitest run",
    "preview": "vite preview",
    "validate": "vitest run tests/content.test.ts",
    "app:dev": "tauri dev",
    "app:build": "NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1 tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickmessing/hackersim.git"
  },
  "description": "A hacker & programmer life simulator with a branching CRPG story, set in 2001."
}
